# Pages already sends nosniff and Referrer-Policy. Re-setting them would
# join with ", ", so they are omitted.
# Preview hosts: detach then set, so a Pages-injected noindex is not doubled.
# Lighthouse SEO "is-crawlable" fails on these hosts by design.
https://:project.pages.dev/*
  ! X-Robots-Tag
  X-Robots-Tag: noindex

https://:version.:project.pages.dev/*
  ! X-Robots-Tag
  X-Robots-Tag: noindex

